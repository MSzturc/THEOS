#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Configuration                        #
########################################

REPO="https://github.com/Arksine/moonraker.git"
DEPS="git"

########################################
# Install dependencies                 #
########################################

apt-get install --yes "${DEPS}"

########################################
# Save current dir and switch to home  #
########################################

pushd "/home/${BASE_USER}" &> /dev/null || exit 1

########################################
# Clone repository                     #
########################################

echo "Cloning Repository"
sudo -u "${BASE_USER}" git clone ${REPO} moonraker

########################################
# Create printer_data directories      #
########################################

create_user_directories

########################################
# Jump into moonraker, run installer   #
# and go back to home                  #
########################################


pushd "moonraker" &> /dev/null || exit 1

echo "Execute installer"
# pin above pillow 9.5.0; it has no 32-bit Python 3.13 wheel and its source build fails on 3.13
PY_MINOR="$(python3 -c 'import sys; print(sys.version_info.minor)')"
PIP_CONSTRAINT_ENV=()
if [ "${PY_MINOR}" -ge 13 ]; then
    printf 'pillow>=10.0.0\n' > /tmp/theos-pip-constraints.txt
    PIP_CONSTRAINT_ENV=(env "PIP_CONSTRAINT=/tmp/theos-pip-constraints.txt")
fi
sudo -u "${BASE_USER}" "${PIP_CONSTRAINT_ENV[@]}" ./scripts/install-moonraker.sh -s -z
rm -f /tmp/theos-pip-constraints.txt

# Get rid of untracked timelapse message
echo "moonraker/components/timelapse.py" | sudo -u "${BASE_USER}" tee -a ".git/info/exclude" > /dev/null

popd &> /dev/null || exit 1

########################################
# Return to saved directory            #
########################################

popd &> /dev/null || exit 1

########################################
# Copy moonraker.conf to config dir    #
########################################

cp /files/moonraker.conf /home/"${BASE_USER}"/printer_data/config/moonraker.conf

########################################
# Enable service                       #
########################################

systemctl_if_exists enable moonraker.service
