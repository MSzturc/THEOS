#!/bin/bash
set -xe
export LC_ALL=C

########################################
# Functions and Basic Configuration    #
########################################

# Load common functions and set up cleanup trap
source /common.sh
install_cleanup_trap

# Load additional configuration (e.g., BASE_USER)
source /files/00-config

########################################
# Set DEBIAN_FRONTEND to               #
# noninteractive                       #
########################################

if [[ "${DEBIAN_FRONTEND}" != "noninteractive" ]]; then
    export DEBIAN_FRONTEND=noninteractive
fi

########################################
# hold linux kernel updates            #
########################################

HELD_PKGS=()
for pattern in "${HOLD_PKGS[@]}"; do
    while IFS= read -r pkg; do
        [[ -n "${pkg}" ]] && HELD_PKGS+=("${pkg}")
    # dpkg-query also lists transitional/meta entries that have no installed
    # version (e.g. linux-dtb-armbian); apt-mark hold exits non-zero on those
    # and aborts the build, so keep only packages in the installed (ii) state.
    done < <(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' "${pattern}" 2>/dev/null \
                | awk '$1 == "ii" { print $2 }' || true)
done
if [[ ${#HELD_PKGS[@]} -gt 0 ]]; then
    apt-mark hold "${HELD_PKGS[@]}"
fi

########################################
# Execute upgrade                      #
########################################

apt-get -y -o Dpkg::Options::="--force-confnew" upgrade

########################################
# Cleanup                              #
########################################

apt-get -y autoremove
apt-get clean

########################################
# release the kernel hold              #
########################################

if [[ ${#HELD_PKGS[@]} -gt 0 ]]; then
    apt-mark unhold "${HELD_PKGS[@]}"
fi

########################################
# Add piwheels to global pip resources #
########################################

if [[ ! -f /etc/pip.conf ]]; then
    echo "Adding piwheels to pip.conf"
    echo "[global]" > /etc/pip.conf
    echo "extra-index-url=https://www.piwheels.org/simple" >> /etc/pip.conf
fi
